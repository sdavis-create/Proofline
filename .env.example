# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase → Project Settings → API. The publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only secrets (added in later phases). Never prefix these with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
